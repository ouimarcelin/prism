<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Cameras and capture cards as clips (ADR 0023). -->
    <key>com.apple.security.device.camera</key><true/>
    <!-- Audio input, for settings that follow the sound. -->
    <key>com.apple.security.device.audio-input</key><true/>
    <!-- The NDI library is installed by the user and signed by its vendor:
         loading it needs library validation off (ADR 0026). -->
    <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
